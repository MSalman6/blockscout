# ==========================================================================
# DMD Blockscout — configuration
#
# The single config file: every credential, hostname, contract address and
# tunable lives here. No YAML or JSON needs editing to move hosts, rotate a
# password, or point at another chain.
#
# ==========================================================================

# --------------------------------------------------------------------------
# COMPOSE WIRING
# Which files form the stack, so every command is just:
#   docker compose --env-file .env.local <cmd>
#   server:    server.yml:bens.yml
#   local dev: docker-compose.yml:custom.yml:bens.yml
# Must live here, not in a plain .env — --env-file replaces .env entirely.
# --------------------------------------------------------------------------
COMPOSE_FILE=server.yml:bens.yml

# --------------------------------------------------------------------------
# BUILD
# Server only. Must equal `version:` in ../mix.exs, or the backend starts and
# then dies looking for config_helper.exs.   grep 'version:' ../mix.exs
# --------------------------------------------------------------------------
RELEASE_VERSION=11.1.0

# --------------------------------------------------------------------------
# HOSTNAMES AND EXPOSURE
# --------------------------------------------------------------------------
EXPLORER_HOST=explorer.staging.bit.diamonds
STATS_BASE_PATH=/bsstats
VISUALIZE_BASE_PATH=/bsvisualize
NEXT_PUBLIC_NAME_SERVICE_API_HOST=https://bens.staging.bit.diamonds
BENS_CORS_ORIGIN=https://explorer.staging.bit.diamonds
BENS_HOST_PORT=17004

# --------------------------------------------------------------------------
# CHAIN SETTINGS
# --------------------------------------------------------------------------
DMD_CHAIN_ID=17771
COIN=DMD
COIN_NAME=Diamond
CHAIN_SPEC_PATH=https://raw.githubusercontent.com/DMDcoin/Diamond/refs/heads/main/spec.json
ETHEREUM_JSONRPC_HTTP_URL=https://rpc.bit.diamonds/rpc
ETHEREUM_JSONRPC_TRACE_URL=https://rpc.bit.diamonds/rpctrace
ETHEREUM_JSONRPC_WS_URL=ws://rpc.bit.diamonds/ws
NEXT_PUBLIC_NETWORK_NAME=DMD Diamond
NEXT_PUBLIC_NETWORK_SHORT_NAME=DMD
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.bit.diamonds/
NEXT_PUBLIC_IS_TESTNET=false

# --------------------------------------------------------------------------
# INDEXER
# --------------------------------------------------------------------------
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=false
IPFS_GATEWAY_URL=http://host.docker.internal:5000

# --------------------------------------------------------------------------
# MARKET DATA
# --------------------------------------------------------------------------
MARKET_COINGECKO_COIN_ID=diamond
MARKET_COINGECKO_API_KEY=

# --------------------------------------------------------------------------
# FRONTEND
# Leave the image vars empty to pull the published image instead of a local build.
# --------------------------------------------------------------------------
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
FRONTEND_IMAGE=
FRONTEND_PULL_POLICY=

# --------------------------------------------------------------------------
# DATABASES
# Generate each:  openssl rand -base64 24 | tr -d '/+=' | head -c 32
# --------------------------------------------------------------------------
POSTGRES_DB=blockscout
POSTGRES_USER=blockscout
POSTGRES_PASSWORD=
STATS_POSTGRES_DB=stats
STATS_POSTGRES_USER=stats
STATS_POSTGRES_PASSWORD=
GRAPH_POSTGRES_DB=graph-node
GRAPH_POSTGRES_USER=graph-node
GRAPH_POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# PGADMIN
# Off unless started with --profile admin; binds 127.0.0.1 only.
# --------------------------------------------------------------------------
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --------------------------------------------------------------------------
# NAME SERVICE - PROTOCOL
# --------------------------------------------------------------------------
DMD_TLD=dmd
DMD_PROTOCOL_SLUG=dmd
DMD_PROTOCOL_SHORT_NAME=DMD Names
DMD_PROTOCOL_TITLE=DMD Naming System
DMD_PROTOCOL_DESCRIPTION=Naming system for the DMD Diamond chain.
DMD_PROTOCOL_DOCS_URL=https://github.com/DMDcoin/diamond-contracts-registry
DMD_EXPLORER_URL=https://explorer.staging.bit.diamonds
NEXT_PUBLIC_NAME_SERVICE_PROTOCOLS=['dmd']
# reverse_registry | all_domains | addr2name | primary_name_record
DMD_ADDRESS_RESOLVE_TECHNIQUE=reverse_registry
# DMD_UPSTREAM_RPC_URL is the real node. DMD_GRAPH_RPC_URL is what graph-node
# talks to
DMD_UPSTREAM_RPC_URL=https://rpc.bit.diamonds/rpc
DMD_GRAPH_RPC_URL=http://rpc-shim:8545
DMD_GRAPH_NETWORK=dmd
DMD_SUBGRAPH_NAME=dmd-subgraph

DMD_REGISTRY_ADDRESS=0x8AA91989f67e186ce28BfE293bC336b46f6e4fE7
DMD_REGISTRY_START_BLOCK=222455
DMD_NAMES_ADDRESS=0xcba1D8a3b237f2E43B949aE0dfA2e46341823F10
DMD_NAMES_START_BLOCK=222458
DMD_RESOLVER_ADDRESS=0x2C8a0437457da46115484F9DbE7b6966444519D2
DMD_RESOLVER_START_BLOCK=222460
DMD_CONTROLLER_ADDRESS=0x04847f99aD1312aFFB1cc6A03a53FEB5fEdd282B
DMD_CONTROLLER_START_BLOCK=222462

# --------------------------------------------------------------------------
# SUBGRAPH BUILD
# --------------------------------------------------------------------------
DMD_SUBGRAPH_PATH=./dmd-subgraph
HOST_UID=1000
HOST_GID=1000
